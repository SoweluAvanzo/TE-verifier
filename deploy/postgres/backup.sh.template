## (The shebang is line 1 of this file, above the header.)
## -e: stop at the first failing command; -u: using an unset variable is an
## error; -o pipefail: a failure inside a pipe (a | b) counts as a failure.
# set -euo pipefail
## umask 077: every file this script creates is readable by its owner only
## (a dump contains every user's data).
# umask 077
#
# BACKUP_DIR=/var/backups/te          # local folder, readable by root only
# RETENTION_DAYS=14                   # keep two weeks locally
# STAMP=$(date +%Y%m%d-%H%M%S)
# FILE="$BACKUP_DIR/te-$STAMP.dump"
#
# mkdir -p "$BACKUP_DIR"
# chmod 700 "$BACKUP_DIR"
#
## pg_dump -Fc: PostgreSQL's "custom" format. Compressed, and pg_restore can
## restore all of it or selected tables. Run as the schema owner (te_migrator);
## inside the container a local connection needs no password.
## `exec -T`: no terminal, so the binary output is not corrupted.
## Written to .partial first: if pg_dump fails, set -e stops the script
## before `mv`, and no broken file is ever named like a good backup.
# docker compose -f /opt/te/compose.yml -f /opt/te/compose.prod.yml exec -T postgres \
#     pg_dump -U te_migrator -d te -Fc > "$FILE.partial"
# mv "$FILE.partial" "$FILE"
#
## Copy off-site. Replace this warning with your real target, for example:
##   rclone copy "$FILE" unito-backup:te-db/
## Until then the warning lands in the cron log every night (stderr).
# echo "WARNING: no off-site copy configured; $FILE exists only on this server" >&2
#
## Delete local dumps older than the retention period ('te-*.dump*' also
## matches the .partial file a failed run may have left).
# find "$BACKUP_DIR" -name 'te-*.dump*' -mtime +"$RETENTION_DAYS" -delete
#
# echo "backup ok: $FILE"

## -----------------------------------------------------------------------------
## RESTORE DRILL (monthly; write the date and result in docs/operations.md)
## -----------------------------------------------------------------------------
## 1. Start a THROW-AWAY postgres container (never restore over production)
##    and wait until it accepts TCP connections. (Checking over TCP, -h,
##    matters: on first start the image runs a temporary server on a local
##    socket only, then restarts it; a socket check would pass too early.)
##      docker run --rm -d --name te-restore -e POSTGRES_PASSWORD=drill postgres:16
##      until docker exec te-restore pg_isready -h 127.0.0.1 -U postgres; do sleep 1; done
## 2. Copy the latest dump into it and restore. The fresh server has no
##    te_app / te_migrator roles, so skip ownership (--no-owner) and the
##    GRANTs to those roles (--no-privileges); the data is what is checked.
##      docker cp /var/backups/te/te-<stamp>.dump te-restore:/tmp/x.dump
##      docker exec te-restore createdb -U postgres te
##      docker exec te-restore pg_restore -U postgres -d te --no-owner --no-privileges /tmp/x.dump
##    pg_restore must end without any "error" line.
## 3. Check it: row counts of sessions, spec_versions and verifications are
##    close to production's; open one recent session's latest spec. The
##    tables live in the schema `te` (init-roles.sql), so name it:
##      docker exec te-restore psql -U postgres -d te -c 'select count(*) from te.sessions'
## 4. Remove the container: docker stop te-restore
